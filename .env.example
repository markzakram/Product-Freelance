# ============================================================
#  KONFIGURASI DASHBOARD GURU FREELANCE
#  Salin file ini menjadi ".env.local" (untuk lokal) atau
#  masukkan sebagai Environment Variables di Vercel.
# ============================================================

# --- 1. Password area internal (WAJIB) ---
# Dipakai untuk login ke /admin (tim internal & HR/Akademik).
INTERNAL_PASSWORD=gantidengansandimu

# --- 2. Koneksi Google Sheets (pilih SALAH SATU cara) ---

# CARA A (disarankan): Service Account.
# Tempel seluruh isi file JSON service account dalam SATU baris,
# atau versi base64-nya. Bagikan ketiga Sheet ke email client_email
# service account (akses Viewer sudah cukup).
GOOGLE_SERVICE_ACCOUNT_JSON=

# CARA B: API Key (hanya jika ketiga Sheet di-set "Anyone with the link: Viewer").
GOOGLE_SHEETS_API_KEY=

# --- 3. ID Spreadsheet (sudah terisi default, ubah bila perlu) ---
SHEET_ID_MASTER=13woeXhJ8-1hNjvJbJeZegsFHbRiDg3Klppj1v4wyBiQ
SHEET_ID_REKAP=14xyyMKPud3i8z9AfivMObOZwiejbMZbu0YuSAO5lRU8
SHEET_ID_JULI=16PZr4sBmozX344o47KYc9EyM7GmZzFmwAtz0gLzfbOQ

# --- 4. Nomor WhatsApp untuk tombol "Ambil Proyek" (format: 62xxxx) ---
